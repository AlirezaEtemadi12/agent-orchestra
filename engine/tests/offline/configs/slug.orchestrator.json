{
    "version": "offline-test",
    "note": "The offline suite's project config, plan filing by slug (Project A's style, plan 0005 D3). The suite copies it into each temp workspace and only fills adapters.mock.args with that workspace's mock-agent path.",
    "description": {
        "title": "orchestrator / run.ps1 - multi-agent, four-gate driver for the offline suite, slug filing (Agent, Ui, Web)",
        "repos": "  - Repos: Agent, Ui, Web - three throwaway git repos under one temp root. The root is not a git repo."
    },
    "planFiling": "slug",
    "root": ".",
    "workflow": {
        "gatesPath": "MISSING-gates.md",
        "rolesPath": "MISSING-roles",
        "rolesIndex": "MISSING-index.md",
        "promptsPath": "MISSING-prompts"
    },
    "repos": { "Agent": "Agent", "Ui": "Ui", "Web": "Web" },
    "roles": {
        "planner": { "gate": 1, "readOnly": true, "auto": false, "promptFile": "plan.md", "chain": [{ "adapter": "mock", "model": "mock-planner", "family": "plannerfam" }] },
        "plan-reviewer": { "gate": 2, "readOnly": true, "auto": false, "promptFile": "check-plan.md", "chain": [{ "adapter": "mock", "model": "mock-reviewer", "family": "reviewerfam" }] },
        "implementer": { "gate": 3, "readOnly": false, "auto": true, "promptFile": "implement.md", "chain": [
            { "adapter": "mock", "model": "mock-impl-a", "family": "implfam" },
            { "adapter": "mock", "model": "mock-impl-b", "family": "implfam2" }
        ] },
        "verifier": { "gate": 4, "readOnly": true, "auto": false, "promptFile": "verify.md", "chain": [{ "adapter": "mock", "model": "mock-verifier", "family": "verifyfam" }] }
    },
    "adapters": {
        "mock": {
            "enabled": true,
            "type": "exec",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "__MOCK_AGENT__"]
        }
    },
    "rules": { "reviewerModelMustDifferFromPlanner": true, "neverCommit": true },
    "preflight": { "enabled": true, "pingPrompt": "Reply with exactly one word: PONG", "timeoutSec": 30 },
    "defaults": { "timeoutSec": 180, "idleTimeoutSec": 0, "agentCwd": "repo", "retryDelaySec": 0, "maxDiffChars": 60000, "refreshGraph": false },
    "verifyCommands": {
        "Agent": ["if (Test-Path .verify-fail) { exit 1 } else { exit 0 }"],
        "Ui": ["if (Test-Path .verify-fail) { exit 1 } else { exit 0 }"],
        "Web": ["if (Test-Path .verify-fail) { exit 1 } else { exit 0 }"]
    },
    "revise": { "maxAutoRounds": 2 },
    "readback": { "enabled": true }
}
