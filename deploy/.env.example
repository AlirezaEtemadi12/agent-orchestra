# Copy to deploy/.env (git-ignored) and point the two folders at each orchestrator's runs folder.

PROJECT1_RUNS=
PROJECT2_RUNS=

# The library needs the project root, mounted read-only, because the runs mount is wider than the
# project. Uncomment both lines to enable it; without them each project logs "library root not set"
# and imports its runs as usual.
# PROJECT1_ROOT=
# PROJECT2_ROOT=

Orchestra__SourceTimeZone=Asia/Tehran

# Plan 0004: the bearer token POST api/events accepts, and nothing else. Empty = the reporter is off
# and the route answers 404. Generate one (for example `openssl rand -hex 32`) and put the same value
# in a Windows environment variable that each project's orchestrator.json names in its report block.
Orchestra__ReportToken=

Orchestra__Projects__0__Id=project-a
Orchestra__Projects__0__Name=Project A
Orchestra__Projects__0__RunsPath=/projects/p1
# Orchestra__Projects__0__RootPath=/projects/root1

Orchestra__Projects__1__Id=project-b
Orchestra__Projects__1__Name=Project B
Orchestra__Projects__1__RunsPath=/projects/p2
# Orchestra__Projects__1__RootPath=/projects/root2
