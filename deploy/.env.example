# Copy to deploy/.env (git-ignored).

# Plan 0009 D13: the one folder that contains your projects, mounted read-only at /host.
# Add each project in the dashboard by the path you see in Windows, e.g. F:\Projects\MyApp.
ORCHESTRA_HOST_ROOT=

# Plan 0006: where the dashboard exports profiles. Mounted at /data/profiles, beside the database.
# Each project's engine reads it through "profilesPath" in its git-ignored orchestrator.local.json.
# Make it writable by the image's uid 10001: chown -R 10001 <this folder>.
ORCHESTRA_PROFILES_DIR=./profiles

Orchestra__SourceTimeZone=Asia/Tehran

# Plan 0009 D6: leave ReportToken unset and the dashboard makes and keeps one in /data/report-token;
# the Connect page shows it. Set it here only to pin a value yourself.
# Orchestra__ReportToken=
