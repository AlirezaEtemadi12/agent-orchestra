{
  "_readme": "Copy this file to appsettings.Local.json (git-ignored) and fill in the projects. RootPath and Library are optional; without them the library reads the .orchestra/ layout under RootPath, which is derived only from an orchestrator/runs or .orchestra/runs RunsPath. ProfilesPath is optional: a relative value sits beside the database (plan 0006 D5).",
  "Orchestra": {
    "SourceTimeZone": "Asia/Tehran",
    "ReportToken": "",
    "ProfilesPath": "",
    "Projects": [
      {
        "Id": "project-a",
        "Name": "Project A",
        "RunsPath": "C:\\path\\to\\ProjectA\\orchestrator\\runs",
        "RootPath": "C:\\path\\to\\ProjectA",
        "Library": {
          "Plans": ["*/.ai/plans/*.md", "*/.ai/plans/done/*.md"],
          "Previews": ["*.html", "orchestrator/runs/_drafts/*.html"],
          "Ideas": ["ideas.md"],
          "Research": ["research/**/*.md"],
          "Evidence": ["screenshots/**/*"]
        }
      },
      {
        "Id": "project-b",
        "Name": "Project B",
        "RunsPath": "C:\\path\\to\\ProjectB\\orchestrator\\runs",
        "RootPath": "C:\\path\\to\\ProjectB",
        "Library": {
          "Plans": ["*/.ai/plans/*.md", "*/.ai/plans/done/*.md"],
          "Previews": ["*.html", "orchestrator/runs/_drafts/*.html"],
          "Ideas": ["ideas.md"],
          "Research": ["research/**/*.md"],
          "Evidence": ["screenshots/**/*"]
        }
      }
    ]
  }
}
